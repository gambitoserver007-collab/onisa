VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
VITE_SUPABASE_PROJECT_ID=tu-proyecto

# Site key (pública) de Cloudflare Turnstile, para el formulario público de
# /tienda/:slug (catálogo en línea). La secret key va como secret de la Edge
# Function create-quote-request (TURNSTILE_SECRET_KEY), nunca aquí.
VITE_TURNSTILE_SITE_KEY=tu-turnstile-site-key

# Nunca pongas aquí la service_role key ni la contraseña de la base de datos.
# Esas son secretas y solo se usan en scripts de servidor (fuera del navegador),
# via variables de entorno propias del servidor (no VITE_*).
